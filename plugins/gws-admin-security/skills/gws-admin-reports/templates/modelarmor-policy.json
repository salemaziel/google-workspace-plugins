{
  "name": "enterprise-pii-filter",
  "filterConfig": {
    "piiFilter": {
      "enabled": true,
      "categories": [
        "EMAIL_ADDRESS",
        "PHONE_NUMBER",
        "CREDIT_CARD_NUMBER",
        "US_SOCIAL_SECURITY_NUMBER"
      ]
    },
    "hateSpeechFilter": {
      "threshold": "MEDIUM_AND_ABOVE"
    },
    "promptInjectionFilter": {
      "threshold": "HIGH"
    }
  }
}
